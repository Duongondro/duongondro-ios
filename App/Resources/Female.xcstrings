        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wtedy znajoma może cię popędzać, a ty dowiesz się, kiedy znajomi praktykują."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тогда подруга сможет вас подгонять, а вы узнаете, когда друзья практикуют."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potom ťa priateľka môže postrčiť a dozvieš sa, keď priatelia cvičia."
