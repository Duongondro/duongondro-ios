    "So a friend can nag you, and you hear when friends practise." : {
      "comment" : "The feminine form of the Localizable string with this key, only where a language conjugates; looked up by Gendered (design: Localisation › Grammatical gender).",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pak tě přítelkyně může popohnat a dozvíš se, když přátelé praktikují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit eine Freundin dich anstupsen kann und du erfährst, wenn Freunde üben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Así una amiga podrá animarte y sabrás cuándo practican tus amigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour qu'une amie puisse te relancer, et que tu saches quand tes amis pratiquent."
