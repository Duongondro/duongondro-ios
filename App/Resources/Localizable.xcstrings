    "Deletes your account and all its data, on the server, on this phone and on your other phones. It cannot be undone." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Smaže tvůj účet a všechna jeho data na serveru, v tomto telefonu i v tvých dalších telefonech. Nelze to vrátit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Löscht dein Konto und alle seine Daten auf dem Server, auf diesem Handy und auf deinen anderen Handys. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina tu cuenta y todos sus datos del servidor, de este teléfono y de tus otros teléfonos. No se puede deshacer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Törli a fiókodat és minden adatát a szerverről, erről a telefonról és a többi telefonodról. Nem vonható vissza."
