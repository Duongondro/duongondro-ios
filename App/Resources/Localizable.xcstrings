      }
    },
    "STREAK_AT_RISK_DISCREET" : {
      "comment" : "The phone's own push key: STREAK_AT_RISK with Discreet notifications on (or a practice the notification extension cannot name), so the lock screen names no practice.",
      "extractionState" : "manual",
