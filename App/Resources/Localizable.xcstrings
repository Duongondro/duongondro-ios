    "Too many tries. Wait a few minutes and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Příliš mnoho pokusů. Počkej pár minut a zkus to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zu viele Versuche. Warte ein paar Minuten und versuche es dann noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Demasiados intentos. Espera unos minutos y vuelve a intentarlo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Túl sok próbálkozás. Várj néhány percet, és próbáld újra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Za dużo prób. Odczekaj kilka minut i spróbuj ponownie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Слишком много попыток. Подождите несколько минут и попробуйте снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Príliš veľa pokusov. Počkaj pár minút a skús to znova."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Забагато спроб. Зачекайте кілька хвилин і спробуйте знову."
          }
        }
      }
    },
