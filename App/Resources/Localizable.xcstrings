    "You can make one later in Settings" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Můžeš si ho vytvořit později v Nastavení"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kannst später in den Einstellungen eines anlegen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes crear una más tarde en Ajustes"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Később is csinálhatsz egyet a Beállításokban"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konto możesz założyć później w Ustawieniach"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Создать его можно позже в настройках"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Môžeš si ho vytvoriť neskôr v Nastaveniach"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Створити його можна пізніше в налаштуваннях"
          }
        }
      }
    },
    "You stop seeing each other's streaks. An invite can make you friends again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přestanete vidět své série navzájem. Pozvánkou se můžete znovu spřátelit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihr seht die Serien des anderen nicht mehr. Mit einer Einladung könnt ihr wieder Freunde werden."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Többé nem látjátok egymás sorozatait. Egy meghívóval újra barátok lehettek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przestajecie widzieć swoje serie. Zaproszenie może ponownie uczynić was przyjaciółmi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы перестанете видеть серии друг друга. Приглашение снова сделает вас друзьями."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prestanete vidieť svoje série. Pozvánkou sa môžete znova stať priateľmi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ви перестанете бачити серії одне одного. Запрошення знову зробить вас друзями."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ninguno de los dos verá ya las rachas del otro. Una invitación puede volver a hacerlos amigos."
          }
        }
      }
    },
    "You usually sit down around now." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obvykle si kolem téhle doby sedáš k meditaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um diese Zeit setzt du dich normalerweise zum Meditieren hin."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ilyenkor szoktál leülni gyakorolni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zwykle siadasz do praktyki mniej więcej o tej porze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обычно вы садитесь практиковать примерно в это время."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Okolo tejto doby si zvyčajne sadáš k meditácii."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зазвичай ви сідаєте медитувати приблизно в цей час."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sueles sentarte a meditar más o menos a esta hora."
          }
        }
      }
    },
    "You usually sit down for %@ around now." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obvykle si kolem téhle doby sedáš k praxi %@."
          }
