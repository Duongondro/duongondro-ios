    "Archiving hides the practice from Today and keeps its counts and history." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Archivace skryje praktiku z obrazovky Dnes a zachová její počty i historii."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Archivieren verschwindet die Übung aus „Heute“; Zählungen und Verlauf bleiben erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'archivage masque la pratique dans Aujourd'hui et conserve ses décomptes et son historique."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az archiválás elrejti a gyakorlatot a Ma képernyőről, de megtartja a számokat és az előzményeket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Archiwizacja ukrywa praktykę w widoku Dziś, a jej liczby i historia zostają zachowane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В архиве практика скрыта с экрана «Сегодня», а её счётчики и история сохраняются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Archivovaním sa cvičenie skryje z obrazovky Dnes, ale zostanú jeho počty a história."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Архівація ховає практику із «Сьогодні», але зберігає її кількості та історію."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al archivar, la práctica deja de verse en Hoy, pero se conservan sus conteos y su historial."
          }
        }
      }
    },
