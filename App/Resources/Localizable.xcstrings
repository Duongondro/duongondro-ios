    "This invite does not check out, so it was not accepted. Ask your friend to send it again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tato pozvánka se nepodařila ověřit, proto nebyla přijata. Požádej přítele, ať ji pošle znovu."
          }
        },
        "de" : {
          "stringUnit" : {
