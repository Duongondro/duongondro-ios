    "Accepting makes the two of you friends: each sees the other's public streaks, never counts." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přijetím se z vás stanou přátelé: každý uvidí veřejné série toho druhého, nikdy ne počty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du annimmst, seid ihr befreundet: Jeder sieht die öffentlichen Serien des anderen, nie die Zählungen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az elfogadással barátok lesztek: mindketten látjátok egymás nyilvános sorozatait, a számokat soha."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po przyjęciu zostajecie przyjaciółmi: każde z was widzi publiczne serie drugiej osoby, ale nigdy liczby."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Если принять, вы станете друзьями: каждый увидит публичные серии другого, но не счётчики."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prijatím sa stanete priateľmi: každý vidí verejné série toho druhého, nikdy nie počty."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Якщо прийняти, ви станете друзями: кожен бачить публічні серії іншого, але ніколи не кількості."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al aceptar, los dos se hacen amigos: cada uno ve las rachas públicas del otro, nunca los conteos."
          }
        }
      }
    },
