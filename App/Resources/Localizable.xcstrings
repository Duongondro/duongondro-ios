    "Your streak so far counts on your own Today screen. Friends only ever see days tracked in the app." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tvá dosavadní série se počítá na tvé obrazovce Dnes. Přátelé vždy vidí jen dny sledované v aplikaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine bisherige Serie zählt auf deinem eigenen Heute-Bildschirm. Freunde sehen immer nur die in der App erfassten Tage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ta série jusqu'ici compte sur ton propre écran Aujourd'hui. Tes amis ne voient que les jours enregistrés dans l'app."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az eddigi sorozatod a saját Ma képernyődön számít. A barátok csak az alkalmazásban követett napokat látják."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dotychczasowa seria liczy się na Twoim ekranie Dziś. Znajomi widzą wyłącznie dni śledzone w aplikacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваша серия до сих пор учитывается на вашем экране «Сегодня». Друзья видят только дни, отмеченные в приложении."
          }
        },
        "sk" : {
