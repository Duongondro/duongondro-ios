          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ta série se termine dans moins de deux heures · jour %2$@"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A sorozatod kevesebb mint két óra múlva véget ér · %2$@. nap"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoja seria kończy się za mniej niż dwie godziny · dzień %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
