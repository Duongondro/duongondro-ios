    "Erase it here and continue? Whatever of it was synced stays in that account." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Smazat ji tady a pokračovat? Co z ní bylo synchronizováno, zůstane v tom účtu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hier löschen und fortfahren? Was davon synchronisiert wurde, bleibt in jenem Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Borrarla aquí y continuar? Lo que se sincronizó sigue en esa cuenta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Törlöd itt, és folytatod? Ami szinkronizálódott belőle, az abban a fiókban marad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usunąć ją tutaj i kontynuować? To, co zostało zsynchronizowane, zostaje w tamtym koncie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стереть её здесь и продолжить? То, что было синхронизировано, останется в том аккаунте."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zmazať ju tu a pokračovať? Čo z nej bolo synchronizované, zostane v tom účte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стерти її тут і продовжити? Те, що було синхронізовано, лишиться в тому обліковому записі."
          }
        }
      }
    },
