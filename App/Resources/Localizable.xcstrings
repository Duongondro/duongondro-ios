    "If you lose this phone, this code is the only way back to your counts. Nobody else has it, not even us." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Když tento telefon ztratíš, jediná cesta zpět k tvým počtům vede přes tento kód. Nikdo jiný ho nemá, ani my."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du dieses Handy verlierst, ist dieser Code der einzige Weg zurück zu deinen Zählungen. Niemand sonst hat ihn, auch wir nicht."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ha elveszíted ezt a telefont, ez a kód az egyetlen út vissza a számaidhoz. Rajtad kívül senkinél nincs meg, nálunk sem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeśli stracisz ten telefon, ten kod to jedyna droga powrotu do Twoich liczb. Nikt inny go nie ma, nawet my."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Если вы потеряете этот телефон, этот код — единственный способ вернуть свои счётчики. Больше его нет ни у кого, даже у нас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ak stratíš tento telefón, tento kód je jediná cesta späť k tvojim počtom. Nikto iný ho nemá, ani my."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Якщо ви втратите цей телефон, цей код — єдиний шлях до ваших кількостей. Більше його ні в кого немає, навіть у нас."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si pierdes este teléfono, este código es la única manera de recuperar tus conteos. Nadie más lo tiene, ni siquiera nosotros."
          }
        }
      }
    },
