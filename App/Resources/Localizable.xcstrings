    "A random name, so friends can tell you apart. Keep it or change it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Náhodné jméno, aby tě přátelé rozeznali. Nech si ho, nebo ho změň."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein zufälliger Name, damit Freunde dich unterscheiden können. Behalte ihn oder ändere ihn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un nombre al azar, para que tus amigos te distingan. Déjalo o cámbialo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un nom tiré au hasard, pour que tes amis puissent te reconnaître. Garde-le ou change-le."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Egy véletlenszerű név, hogy a barátaid meg tudjanak különböztetni. Megtarthatod vagy megváltoztathatod."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Losowe imię, żeby znajomi mogli cię rozpoznać. Zostaw je albo zmień."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Случайное имя, чтобы друзья могли вас различать. Оставьте его или измените."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Náhodné meno, aby ťa priatelia rozoznali. Nechaj si ho, alebo ho zmeň."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Випадкове ім’я, щоб друзі могли вас розрізняти. Залиште його або змініть."
          }
        }
      }
    },
    "A second way to sign in, for example on a new phone." : {
