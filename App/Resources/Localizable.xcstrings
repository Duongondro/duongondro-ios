            "value" : "Код, який ви записали, перестане діяти."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El código que anotaste deja de funcionar."
          }
        }
      }
    },
    "The code you wrote down when you set up your first phone. Spaces and dashes do not matter." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kód zapsaný při nastavení prvního telefonu. Na mezerách a pomlčkách nezáleží."
