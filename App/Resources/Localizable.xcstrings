    },
    "You stop seeing each other's streaks. A friendship code can make you friends again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přestanete vidět své série navzájem. Kódem přátelství se můžete znovu spřátelit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihr seht die Serien des anderen nicht mehr. Mit einem Freundschaftscode könnt ihr wieder Freunde werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous ne verrez plus vos séries respectives. Un code d'amitié peut vous rendre de nouveau ami(e)s."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Többé nem látjátok egymás sorozatait. Egy barátságkóddal újra barátok lehettek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przestajecie widzieć swoje serie. Kod przyjaźni może ponownie uczynić was znajomymi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы перестанете видеть серии друг друга. Код дружбы снова сделает вас друзьями."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prestanete vidieť svoje série. Kódom priateľstva sa môžete znova stať priateľmi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ви перестанете бачити серії одне одного. Код дружби знову зробить вас друзями."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ninguno de los dos verá ya las rachas del otro. Un código de amistad puede volver a haceros amigos."
          }
        }
      }
    },
    "You usually sit down around now." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obvykle si kolem téhle doby sedáš k meditaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um diese Zeit setzt du dich normalerweise zum Meditieren hin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "D'habitude, tu t'installes à peu près à cette heure-ci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ilyenkor szoktál leülni gyakorolni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zwykle siadasz do praktyki mniej więcej o tej porze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обычно вы садитесь практиковать примерно в это время."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Okolo tejto doby si zvyčajne sadáš k meditácii."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зазвичай ви сідаєте медитувати приблизно в цей час."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sueles sentarte a meditar más o menos a esta hora."
          }
        }
      }
    },
    "You usually sit down for %@ around now." : {
      "localizations" : {
        "cs" : {
