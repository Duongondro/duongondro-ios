        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezen a telefonon nincs hozzáférési kulcs a Duongöndróhoz. Használd inkább az e-mail-címedet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na tym telefonie nie ma klucza dostępu do Duongöndro. Użyj adresu e-mail."
