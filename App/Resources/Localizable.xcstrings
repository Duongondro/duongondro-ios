    "Too many sign-ups from this network in the last hour. Try again later, or open a friend's friendship link." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Z této sítě bylo za poslední hodinu příliš mnoho registrací. Zkus to později, nebo otevři odkaz s kódem přátelství od přítele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aus diesem Netz gab es in der letzten Stunde zu viele Registrierungen. Versuch es später, oder öffne den Freundschaftslink eines Freundes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desde esta red ha habido demasiados registros en la última hora. Inténtalo más tarde o abre el enlace de amistad de un amigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trop d'inscriptions depuis ce réseau au cours de la dernière heure. Réessaie plus tard, ou ouvre le lien d'amitié d'un(e) ami(e)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erről a hálózatról az elmúlt órában túl sok regisztráció történt. Próbáld újra később, vagy nyisd meg egy barátod barátságlinkjét."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Z tej sieci było w ostatniej godzinie zbyt wiele rejestracji. Spróbuj później albo otwórz link z kodem przyjaźni od znajomego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
