    "Next we'll ask for two of these groups, to make sure." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro jistotu se tě za chvíli zeptáme na dvě z těchto skupin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als Nächstes fragen wir zur Sicherheit nach zwei dieser Gruppen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezután a biztonság kedvéért kettőt kérünk ezek közül a csoportok közül."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dla pewności poprosimy zaraz o dwie z tych grup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Дальше мы попросим ввести две из этих групп, чтобы убедиться."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potom sa ťa spýtame na dve z týchto skupín, aby sme si boli istí."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Далі ми запитаємо про дві з цих груп, щоб переконатися."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A continuación te pediremos dos de estos grupos, para estar seguros."
          }
        }
      }
    },
    "No account and no network. You can sign up later and keep everything." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Žádný účet ani síť. Zaregistrovat se můžeš později a všechno si necháš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kein Konto und kein Netzwerk. Du kannst dich später anmelden und alles behalten."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fiók és hálózat nélkül. Később regisztrálhatsz, és minden megmarad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bez konta i bez sieci. Zarejestrujesz się później i zachowasz wszystko."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Без аккаунта и без сети. Позже можно зарегистрироваться и сохранить всё."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bez účtu a bez siete. Zaregistrovať sa môžeš neskôr a všetko si ponecháš."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Без облікового запису й без мережі. Зареєструватися можна пізніше, і все збережеться."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sin cuenta y sin red. Puedes registrarte después y conservar todo."
          }
        }
      }
    },
    "No account on this phone yet" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "V tomto telefonu zatím není žádný účet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
