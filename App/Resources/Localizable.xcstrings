    "Your phone offers the passkey you saved. No passkey on this phone? We email you a link and a code." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Telefon nabídne uložený přístupový klíč. Žádný klíč v tomto telefonu? Pošleme ti e-mailem odkaz a kód."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Handy bietet den gespeicherten Passkey an. Kein Passkey auf diesem Handy? Wir schicken dir einen Link und einen Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu teléfono ofrece la clave de acceso que guardaste. ¿Sin clave de acceso en este teléfono? Te enviamos un enlace y un código por correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ton téléphone propose la clé d'accès que tu as enregistrée. Pas de clé d'accès sur ce téléphone ? Nous t'envoyons un lien et un code par e-mail."
