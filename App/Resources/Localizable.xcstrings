    "An evening nudge when a streak is at risk. It is scheduled on this phone; nothing leaves it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Večerní připomenutí, když je série v ohrožení. Plánuje se v tomto telefonu a nic z něj neodchází."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Anstoß am Abend, wenn deine Serie in Gefahr ist. Er wird auf diesem Handy geplant; nichts verlässt es."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esti emlékeztető, ha veszélyben van a sorozatod. Ezen a telefonon van beütemezve, semmi nem hagyja el."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wieczorne przypomnienie, gdy seria jest zagrożona. Jest ustawiane na tym telefonie i nic go nie opuszcza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вечернее напоминание, когда серия под угрозой. Оно настраивается на этом телефоне, и ничего не уходит с него."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Večerné pripomenutie, keď je séria v ohrození. Plánuje sa v tomto telefóne; nič z neho neodchádza."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вечірнє нагадування, коли серії загрожує обрив. Його планує сам телефон, і нічого з нього не виходить."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un recordatorio por la tarde cuando tu racha está en riesgo. Se programa en este teléfono; nada sale de él."
          }
        }
      }
    },
    "An hour before you usually practise, learned on this phone from the last two weeks." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hodinu před tím, kdy obvykle praktikuješ. Telefon se to učí z posledních dvou týdnů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Stunde vor deiner üblichen Übungszeit, auf diesem Handy aus den letzten zwei Wochen gelernt."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Egy órával a szokásos gyakorlási időd előtt; a telefon az elmúlt két hétből tanulta meg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Godzinę przed porą, o której zwykle praktykujesz. Telefon uczy się jej z ostatnich dwóch tygodni."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "За час до вашего обычного времени практики. Оно определяется на этом телефоне по последним двум неделям."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hodinu predtým, ako zvyčajne cvičíš. Telefón sa to učí z posledných dvoch týždňov."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "За годину до того часу, коли ви зазвичай практикуєте; телефон визначає його за останні два тижні."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una hora antes de la hora en que sueles practicar, calculada en este teléfono con las últimas dos semanas."
          }
        }
      }
    },
