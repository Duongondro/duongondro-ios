    "So %@ can nag you, and you hear when friends practise." : {
      "comment" : "Friends: why to allow notifications; %@ is a friend's name.",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pak tě %@ může popohnat a dozvíš se, když přátelé praktikují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit %@ dich anstupsen kann und du erfährst, wenn Freunde üben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "So %@ can nag you, and you hear when friends practise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Así %@ podrá animarte y sabrás cuándo practican tus amigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour que %@ puisse te relancer, et que tu saches quand tes amis pratiquent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Így %@ noszogathat, és megtudod, mikor gyakorolnak a barátaid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wtedy %@ może cię popędzać, a ty dowiesz się, kiedy znajomi praktykują."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тогда %@ сможет вас подгонять, а вы узнаете, когда друзья практикуют."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potom ťa %@ môže postrčiť a dozvieš sa, keď priatelia cvičia."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тоді %@ зможе вас підганяти, а ви дізнаєтеся, коли друзі практикують."
          }
        }
      }
    },
    "So a friend can nag you, and you hear when friends practise." : {
      "comment" : "Looked up by Gendered for a friend without a display name: the neutral (masculine) form; Female.xcstrings holds the feminine one.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pak tě přítel může popohnat a dozvíš se, když přátelé praktikují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit ein Freund dich anstupsen kann und du erfährst, wenn Freunde üben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Así un amigo podrá animarte y sabrás cuándo practican tus amigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour qu'un(e) ami(e) puisse te relancer, et que tu saches quand tes amis pratiquent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Így egy barátod noszogathat, és megtudod, mikor gyakorolnak a barátaid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wtedy znajomy może cię popędzać, a ty dowiesz się, kiedy znajomi praktykują."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тогда друг сможет вас подгонять, а вы узнаете, когда друзья практикуют."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potom ťa priateľ môže postrčiť a dozvieš sa, keď priatelia cvičia."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тоді друг зможе вас підганяти, а ви дізнаєтеся, коли друзі практикують."
          }
        }
      }
