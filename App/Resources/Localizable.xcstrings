    "STREAK_AT_RISK" : {
      "comment" : "Push loc-key, rendered by the system when the notification extension does not run, so it never names the practice (the server sends its id, and Discreet notifications may be on): your public streak ends in under two hours: %2$@ the day of the streak; %1$@, the practice id, is left out.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tvoje série skončí za necelé dvě hodiny · den %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Serie endet in weniger als zwei Stunden · Tag %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
