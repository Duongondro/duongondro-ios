          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kod zapisany przy konfiguracji pierwszego telefonu. Spacje i myślniki nie mają znaczenia."
          }
        },
        "ru" : {
          "stringUnit" : {
