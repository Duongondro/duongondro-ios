    "Friends see your public streaks and nothing else. An online account lets you add them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přátelé vidí jen tvé veřejné série, nic dalšího. S online účtem si je můžeš přidat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Freunde sehen deine öffentlichen Serien und sonst nichts. Mit einem Online-Konto kannst du sie hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus amigos ven tus rachas públicas y nada más. Con una cuenta en línea puedes añadirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tes amis voient tes séries publiques, et rien d'autre. Un compte en ligne te permet de les ajouter."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A barátok csak a nyilvános sorozataidat látják, mást semmit. Online fiókkal felveheted őket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Znajomi widzą tylko Twoje publiczne serie i nic więcej. Z kontem online możesz ich dodać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Друзья видят только ваши публичные серии и ничего больше. С онлайн-аккаунтом вы сможете их добавить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Priatelia vidia tvoje verejné série a nič iné. S online účtom si ich môžeš pridať."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Друзі бачать лише ваші публічні серії і більше нічого. З онлайн-обліковим записом ви зможете їх додати."
          }
        }
      }
    },
