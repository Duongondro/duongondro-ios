    "POKE" : {
      "comment" : "Push loc-key, rendered by the phone (design: Localisation › Localised pushes). A friend poked you (once a day at most), neutral form (non-binary or no gender given): %1$@ their name. In the mascot's voice, written per language.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ do tebe šťouchá. Nesedneš si k meditaci?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ hat dich angestupst. Zeit, dich hinzusetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ poked you. Time to sit down?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ te dio un toque. ¿Hora de sentarte a meditar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ te relance. Et si tu t'asseyais ?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ megbökött. Ideje leülni gyakorolni?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ cię szturcha. Czas usiąść do praktyki?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ подталкивает вас. Пора садиться практиковать?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ do teba štuchá. Nesadneš si k meditácii?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ підштовхує вас. Час сідати практикувати?"
          }
        }
      }
    },
