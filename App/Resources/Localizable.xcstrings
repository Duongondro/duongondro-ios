          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Csak ezzel tudsz belépni a fiókodba, ezért marad. Előbb adj hozzá egy másik hozzáférési kulcsot vagy egy e-mail-címet."
