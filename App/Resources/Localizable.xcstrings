    "Before signing out here, finish your recovery code: without it, your counts could not come back." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Než se tu odhlásíš, dokonči obnovovací kód: bez něj by se tvé počty nedaly vrátit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bevor du dich hier abmeldest, schließe deinen Wiederherstellungscode ab: Ohne ihn könnten deine Zählungen nicht zurückkommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
