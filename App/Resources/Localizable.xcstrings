        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Napíš alebo vlož kód pozvánky, prípadne vlož celý odkaz s pozvánkou. Na veľkosti písmen nezáleží."
          }
        },
        "uk" : {
