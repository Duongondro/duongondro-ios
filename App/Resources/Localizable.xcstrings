    "Ends the friendship both ways and stops invites and nudges between you." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ukončí přátelství na obou stranách a zastaví pozvánky i šťouchance mezi vámi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beendet die Freundschaft für beide Seiten und stoppt Einladungen und Anstupser zwischen euch."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mindkét irányban megszünteti a barátságot, és leállítja a meghívókat és a figyelmeztetéseket köztetek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kończy przyjaźń po obu stronach i wstrzymuje zaproszenia oraz szturchnięcia między wami."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Прекращает дружбу с обеих сторон, приглашения и подталкивания между вами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ukončí priateľstvo na oboch stranách a zastaví pozvánky a šťuchnutia medzi vami."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Припиняє дружбу з обох боків і зупиняє запрошення та підштовхування між вами."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termina la amistad para ambos y detiene las invitaciones y los toques entre los dos."
          }
        }
      }
    },
    "Erase and continue" : {
      "localizations" : {
