    "This account already has keys: restore it with its recovery code instead." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tento účet už klíče má: obnov ho raději pomocí jeho obnovovacího kódu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Konto hat bereits Schlüssel: Stelle es stattdessen mit seinem Wiederherstellungscode wieder her."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce compte a déjà des clés : restaure-le plutôt avec son code de récupération."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ennek a fióknak már vannak kulcsai: inkább a helyreállítási kódjával állítsd vissza."
