          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Met fin à l'amitié des deux côtés et bloque les codes d'amitié et les relances entre vous."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mindkét irányban megszünteti a barátságot, és leállítja a barátságkódokat és a figyelmeztetéseket köztetek."
